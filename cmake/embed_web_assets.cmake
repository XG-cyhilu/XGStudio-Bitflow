function(bitflow_embed_assets web_dir out_dir)
    file(MAKE_DIRECTORY "${out_dir}")
    file(GLOB_RECURSE entries CONFIGURE_DEPENDS RELATIVE "${web_dir}" "${web_dir}/*")
    list(SORT entries)
    list(LENGTH entries count)

    set(rc_content "")
    set(hdr_content "// generated by cmake/embed_web_assets.cmake\n#pragma once\n\nstruct BitflowAsset {\n    int id;\n    const wchar_t* path;\n};\n\ninline const BitflowAsset kBitflowAssets[] = {\n")

    set(base_id 1000)
    set(id ${base_id})
    foreach(rel IN LISTS entries)
        math(EXPR id "${id} + 1")
        string(REPLACE "/" "\\\\" native_path "${web_dir}/${rel}")
        string(APPEND rc_content "${id} RCDATA \"${native_path}\"\n")
        string(APPEND hdr_content "    {${id}, L\"${rel}\"},\n")
    endforeach()

    string(APPEND hdr_content "};\n\ninline const int kBitflowAssetCount = ${count};\n")

    file(WRITE "${out_dir}/web_assets.rc" "${rc_content}")
    file(WRITE "${out_dir}/WebAssets.generated.h" "${hdr_content}")

    set(BF_WEB_RC "${out_dir}/web_assets.rc" PARENT_SCOPE)
endfunction()
